{
  "rules": {
    ".read": false,
    ".write": false,
    "mfma": {
      "state": {
        ".read": true,
        ".write": "auth != null && (auth.uid === '2DCyQB0Js1UpWGI0LkEQtnOhGPl1' || auth.uid === 'UqAXXX1tq9d5I34QTF3USu3vaUb2')",
        "event": {
          "vehicleReports": {
            "$vehicleId": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && ($vehicleId === 'ranger' || $vehicleId === 'shelly' || $vehicleId === 'gator')",
              ".validate": "newData.hasChildren(['driverName', 'passengerName', 'submittedAt'])",
              "driverName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50" },
              "passengerName": { ".validate": "newData.isString() && newData.val().length <= 50" },
              "submittedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
              "$other": { ".validate": false }
            }
          },
          "hazards": {
            "$hazardId": {
              ".write": "auth != null && auth.token.firebase.sign_in_provider === 'anonymous' && !data.exists() && newData.child('status').val() === 'open' && !newData.hasChild('acknowledgedAt') && !newData.hasChild('resolvedAt') && !newData.hasChild('rdNotes')",
              ".validate": "newData.hasChildren(['vehicleId', 'description', 'category', 'requestStopClock', 'requestSafetyCar', 'status', 'createdAt'])",
              "vehicleId": { ".validate": "newData.isString() && (newData.val() === 'ranger' || newData.val() === 'shelly' || newData.val() === 'gator')" },
              "description": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 240" },
              "category": { ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'Debris' || newData.val() === 'Track' || newData.val() === 'Vehicle' || newData.val() === 'Other')" },
              "requestStopClock": { ".validate": "newData.isBoolean()" },
              "requestSafetyCar": { ".validate": "newData.isBoolean()" },
              "status": { ".validate": "newData.isString() && (newData.val() === 'open' || newData.val() === 'acknowledged' || newData.val() === 'resolved')" },
              "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
              "acknowledgedAt": { ".validate": "newData.isNumber()" },
              "resolvedAt": { ".validate": "newData.isNumber()" },
              "rdNotes": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
